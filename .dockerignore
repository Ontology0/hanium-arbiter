# Default deny. Reopened directories are immediately denied recursively so
# allowing a parent never includes private files added beneath it later.
**
!Dockerfile
!.dockerignore
!.railwayignore
!railway.json
!pyproject.toml
!uv.lock
!slack-app-manifest.json

!backend/
backend/**
!backend/arbiter/
backend/arbiter/**
!backend/arbiter/*.py
!backend/arbiter/data/
backend/arbiter/data/**
!backend/arbiter/data/*.json

!frontend/
frontend/**
!frontend/index.html
!frontend/landing.html
!frontend/app.js
!frontend/styles.css
!frontend/landing.css
!frontend/download.html
!frontend/download.js
!frontend/downloads/
frontend/downloads/**
!frontend/downloads/culture-fit-source.zip
!frontend/downloads/culture-fit-skill.zip

!experiments/
experiments/**
!experiments/results/
experiments/results/**
!experiments/results/latest/
experiments/results/latest/**
!experiments/results/latest/summary.json

# Also deny credential/state filenames inside otherwise allowed source folders.
**/.env
**/.env.*
**/.runtime/**
**/__pycache__/**
**/*.db
**/*.sqlite
**/*.sqlite3
**/credentials.json
**/*.pem
**/*.key
