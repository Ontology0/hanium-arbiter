            1022
          ]
        ],
        "bottom_margin": 58
      },
      {
        "id": "product-21",
        "start": 167,
        "end": 174.35,
        "lines": [
          "Culture-Fit is MIT-licensed open source, built for",
          "developers everywhere to adapt and connect."
        ],
        "glyph_bounds": [
          [
            445.5,
            922,
            1474.5,
            966
          ],
          [
            475.0,
            980,
            1445.0,
