        "bottom_margin": 59
      },
      {
        "id": "product-20",
        "start": 159.4,
        "end": 167,
        "lines": [
          "A2A and Skill interfaces offer additional ways",
          "to connect the agent environments you use."
        ],
        "glyph_bounds": [
          [
            478.5,
            922,
            1441.5,
            965
          ],
          [
            495.0,
